/* Single source of truth for the device kernels and the host helpers that must match them.
   Included by every harness in this directory; no kernel is duplicated anywhere.
   hipcc-only (contains __global__ and __constant__). */
#ifndef GPU_KERNELS_HI
#define GPU_KERNELS_HI

#include <hip/hip_runtime.h>
#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>
#include <vector>
#include <algorithm>
#include <ctime>

#define RSB     12
#define RSZ     (1u << RSB)
#define RANS_L  (1u << 23)
#ifndef SYMBITS
#define SYMBITS 6
#endif
#define NSYM    (1 << SYMBITS)
#define MAXTAB  128

/* ------------------------------------------------------------ entropy types */
struct gtab_t {                 /* encoder: freq + cumulative start + reciprocal */
    uint16_t freq[NSYM];
    uint32_t start[NSYM];
    uint32_t rcp[NSYM];
};

struct dtab_t {                 /* decoder: adds the 4 KB slot lookup */
    uint32_t start[NSYM];
    uint16_t freq[NSYM];
    uint8_t  slot[RSZ];
};

/* Tables live in a device buffer rather than __constant__: a hipMemcpyToSymbol issued
   before any kernel that uses the symbol has been registered can be silently dropped, which
   made the very first encode in a process use garbage tables. */

/* --------------------------------------------------------------- transform */
typedef short v2s __attribute__((ext_vector_type(2)));

/* Which coefficients of this group become significant at plane p. Shared by both iterate
   paths in the symboliser. */
__device__ __forceinline__ int group_newly(const int16_t *row, int x, int i, int n, int bw, int pw,
                                           int p, const uint32_t *nw, int nwidx)
{
    if (nw) return (int)((nw[nwidx] >> (i >> 5)) & 1u);
    const int16_t *sr = row;
    int sx = x;
    int rem = n - i; if (rem > 32) rem = 32;
    for (int k = 0; k < rem; k++) {
        int v = sr[sx]; int m = v < 0 ? -v : v;
        if (!(m >> (p + 1)) && ((m >> p) & 1)) return 1;
        if (++sx == bw) { sx = 0; sr += pw; }
    }
    return 0;
}

/* Emitting one coefficient's bit for one context. This is the whole branch structure of the
   symboliser, written once. */
__device__ __forceinline__ void sym_coef(int v, int m, int p, int ctx, int newly,
                                         int emit, uint8_t *ob, uint32_t &nb)
{
    if (m >> (p + 1)) {
        if (ctx == 3) {
            if (emit && ((m >> p) & 1)) ob[nb >> 3] |= (uint8_t)(1u << (nb & 7));
            nb++;
        }
    } else if (newly) {
        int bit = (m >> p) & 1;
        if (ctx == 1) {
            if (emit && bit) ob[nb >> 3] |= (uint8_t)(1u << (nb & 7));
            nb++;
        } else if (ctx == 2 && bit) {
            if (emit && v < 0) ob[nb >> 3] |= (uint8_t)(1u << (nb & 7));
            nb++;
        }
    }
}

/* Two int16 coefficients per 32-bit register: v_pk_add_u16 / v_pk_ashrrev_i16 are single
   instructions on gfx1201, so a contiguous pair costs one load and one shift instead of two. */
/* Magnitudes must be int, not int16: |(-32768)| is 32768 and does not fit in a short, which
   made the packed path disagree with the scalar path on exactly one input value. */
__device__ __forceinline__ void v2abs(int &m0, int &m1, v2s v)
{
    int a = v[0], b = v[1];
    m0 = a < 0 ? -a : a;
    m1 = b < 0 ? -b : b;
}

/* The classification of one coefficient. Both the packed and the scalar classify loops call
   this: they differ only in how the magnitude is fetched and how fast they advance, so the
   branch logic exists once. */
__device__ __forceinline__ void classify(int m, int p, int newly, int k,
                                         uint32_t &amask, uint32_t &qmask, int &csig, int &cref)
{
    if (m >> (p + 1)) { amask |= 1u << k; cref++; }
    else if (newly)   { qmask |= 1u << k; csig++; }
}

__device__ __forceinline__ int mir(int i, int n)
{
    while (i < 0 || i >= n) {
        if (i < 0) i = -i - 1;
        else       i = 2 * n - 1 - i;
    }
    return i;
}

/* One work-group per line. Two parallel phases split by a barrier: predict reads only
   input samples, update reads only predicted details. */
/* Phase-split 5/3 lifting, one thread per output sample.

   The old form staged a whole line in LDS and lifted it there, which forced one work-group per
   line: for the column pass that means reading with stride = row pitch, so every sample drags a
   whole cache line - about 265 MB of line traffic per pass at 1080p, and it dominated the
   transform. Splitting the lifting into its predict and update phases removes the need for LDS
   staging entirely, so both the read of the source and the write of the result can be laid out
   coalesced: threads are mapped so that adjacent threads touch adjacent addresses on whichever
   axis is being transformed.

   The cost is that the packed output (lowpass at 0..nev-1, details at nev..n-1) overlaps the
   input, so the caller ping-pongs between the plane and a scratch buffer. Detail values needed
   by the update phase are recomputed from the source rather than read back, which keeps each
   axis to a single pass.

   Both axes use the same kernels:
     rows:    line_pitch = w, stride = 1, nlines = h, n = w, posmajor = 1
     columns: line_pitch = 1, stride = w, nlines = w, n = h, posmajor = 0
*/
/* The reference writes each detail into the int16 line and reads it back, so a value that
   overflows int16 is truncated at that point. Recomputing it must truncate identically, or the
   update phase sees a different number than the stored one. */
__device__ __forceinline__ int det_at(const int16_t *s, int stride, int j, int nev)
{
    int a = s[2 * mir(j, nev) * stride];
    int b = s[2 * mir(j + 1, nev) * stride];
    return (int16_t)(s[(2 * j + 1) * stride] - ((a + b) >> 1));
}

__device__ __forceinline__ int ev_at(const int16_t *s, int stride, int j, int nev, int nod)
{
    int dm = s[(nev + mir(j - 1, nod)) * stride];
    int dp = s[(nev + mir(j, nod)) * stride];
    return (int16_t)(s[j * stride] - ((dm + dp + 2) >> 2));
}

/* Lossy mode costs nothing in the container: truncating low bitplanes before symbolisation
   means the decoder reconstructs exactly what was coded, so no quantiser side information is
   needed. The bitplane count follows automatically because k_block_mb measures the truncated
   coefficients. */
__global__ void k_quant_rect(int16_t * __restrict__ buf, int pitch,
                             int x0, int y0, int w, int h, int shift)
{
    int x = blockIdx.x * blockDim.x + threadIdx.x;
    int y = blockIdx.y * blockDim.y + threadIdx.y;
    if (x >= w || y >= h) return;
    int16_t *p = &buf[(y0 + y) * pitch + x0 + x];
    int v = *p;
    *p = (int16_t)((v >> shift) << shift);
}

/* A slice list, passed by value so one launch can carry every slice of a frame. Without this the
   transform launches once per slice per level per axis, and at 60-line slices that was 540 small
   launches costing 3.2 ms against 0.36 ms of work. */
#define W5C_MAXSLICE 32
struct spr { int y0[W5C_MAXSLICE]; int nl[W5C_MAXSLICE]; int n[W5C_MAXSLICE]; };

__global__ void k_dwt_fwd_split(const int16_t * __restrict__ src, int16_t * __restrict__ dst,
                                int y0_step, int line_pitch, int stride,
                                int posmajor, spr sp, int ns, int wav)
{
    int sl = blockIdx.y;
    if (sl >= ns) return;
    int n = sp.n[sl], nlines = sp.nl[sl];
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int line, k;
    if (posmajor) { line = idx / n; k = idx - line * n; }
    else          { k = idx / nlines; line = idx - k * nlines; }
    if (line >= nlines || k >= n) return;

    int nev = (n + 1) / 2, nod = n / 2;
    int org = sp.y0[sl] * y0_step;
    const int16_t *s = src + org + line * line_pitch;
    int16_t *d = dst + org + line * line_pitch;
    if (n <= 1) { d[0] = s[0]; return; }

    if (wav) {
        /* Haar (1/1): the detail needs only its own pair, so there is no neighbour to fetch and
           no vertical support beyond one line - that is the property that would make a slice
           restart nearly free. */
        int a = 0, b = 0, dd = 0;
        if (k < nod) { a = s[2 * k * stride]; b = s[(2 * k + 1) * stride]; dd = b - a;
                       d[(nev + k) * stride] = (int16_t)dd; }
        if (k < nev) {
            int ev = s[2 * k * stride];
            d[k * stride] = (int16_t)(ev + (dd >> 1));
        }
    } else {
        if (k < nod)
            d[(nev + k) * stride] = (int16_t)det_at(s, stride, k, nev);
        if (k < nev) {
            int dm = det_at(s, stride, mir(k - 1, nod), nev);
            int dp = det_at(s, stride, mir(k, nod), nev);
            d[k * stride] = (int16_t)(s[2 * k * stride] + ((dm + dp + 2) >> 2));
        }
    }
}

__global__ void k_dwt_inv_split(const int16_t * __restrict__ src, int16_t * __restrict__ dst,
                                int y0_step, int line_pitch, int stride,
                                int posmajor, spr sp, int ns, int wav)
{
    int sl = blockIdx.y;
    if (sl >= ns) return;
    int n = sp.n[sl], nlines = sp.nl[sl];
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int line, k;
    if (posmajor) { line = idx / n; k = idx - line * n; }
    else          { k = idx / nlines; line = idx - k * nlines; }
    if (line >= nlines || k >= n) return;

    int nev = (n + 1) / 2, nod = n / 2;
    int org = sp.y0[sl] * y0_step;
    const int16_t *s = src + org + line * line_pitch;
    int16_t *d = dst + org + line * line_pitch;
    if (n <= 1) { d[0] = s[0]; return; }

    if (wav) {
        if (k < nod) {
            int dd = s[(nev + k) * stride];
            int ev = s[k * stride] - (dd >> 1);
            d[2 * k * stride] = (int16_t)ev;
            d[(2 * k + 1) * stride] = (int16_t)(dd + ev);
        } else if (k < nev) {
            d[2 * k * stride] = s[k * stride];
        }
    } else {
        if (k < nev)
            d[2 * k * stride] = (int16_t)ev_at(s, stride, k, nev, nod);
        if (k < nod) {
            int a = ev_at(s, stride, mir(k, nev), nev, nod);
            int b = ev_at(s, stride, mir(k + 1, nev), nev, nod);
            d[(2 * k + 1) * stride] = (int16_t)(s[(nev + k) * stride] + ((a + b) >> 1));
        }
    }
}

__global__ void k_enc(const gtab_t * __restrict__ c_tab,
                      const uint8_t * __restrict__ sym,
                      const uint32_t * __restrict__ soff,
                      const uint32_t * __restrict__ slen,
                      const uint16_t * __restrict__ stab,
                      const uint32_t * __restrict__ cap,
                      const uint32_t * __restrict__ ooff,
                      uint8_t * __restrict__ out,
                      uint32_t * __restrict__ olen,
                      int nstreams)
{
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= nstreams) return;
    uint32_t n = slen[i];
    if (n == 0) { olen[i] = 0; return; }

    const gtab_t *t = &c_tab[stab[i]];
    const uint8_t *s = sym + soff[i];
    uint32_t cp = cap[i];
    uint8_t *base = out + ooff[i];
    uint8_t *p = base + cp;
    uint32_t x = RANS_L;

    for (uint32_t k = n; k-- > 0;) {
        uint32_t f = t->freq[s[k]], st = t->start[s[k]];
        uint32_t x_max = ((RANS_L >> RSB) << 8) * f;
        while (x >= x_max) { *--p = (uint8_t)x; x >>= 8; }
        x = ((x / f) << RSB) + (x % f) + st;
    }
    p -= 4;
    p[0] = (uint8_t)x; p[1] = (uint8_t)(x >> 8);
    p[2] = (uint8_t)(x >> 16); p[3] = (uint8_t)(x >> 24);
    uint32_t sz = (uint32_t)(base + cp - p);
    for (uint32_t j = 0; j < sz; j++) base[j] = p[j];
    olen[i] = sz;
}

/* Same, without integer division: rcp = floor(2^31/f)+1, invariant x < 2^31, so the
   estimate is exact or one high and a single decrement fixes it. */
__global__ void k_enc_rcp(const gtab_t * __restrict__ c_tab,
                          const uint8_t * __restrict__ sym,
                          const uint32_t * __restrict__ soff,
                          const uint32_t * __restrict__ slen,
                          const uint16_t * __restrict__ stab,
                          const uint32_t * __restrict__ cap,
                          const uint32_t * __restrict__ ooff,
                          uint8_t * __restrict__ out,
                          uint32_t * __restrict__ olen,
                          int nstreams)
{
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= nstreams) return;
    uint32_t n = slen[i];
    if (n == 0) { olen[i] = 0; return; }

    const gtab_t *t = &c_tab[stab[i]];
    const uint8_t *s = sym + soff[i];
    uint32_t cp = cap[i];
    uint8_t *base = out + ooff[i];
    uint8_t *p = base + cp;
    uint32_t x = RANS_L;

    for (uint32_t k = n; k-- > 0;) {
        uint32_t f = t->freq[s[k]], st = t->start[s[k]];
        uint32_t x_max = ((RANS_L >> RSB) << 8) * f;
        while (x >= x_max) { *--p = (uint8_t)x; x >>= 8; }
        uint32_t q = (uint32_t)(((uint64_t)x * t->rcp[s[k]]) >> 31);
        uint32_t r = x - q * f;
        if ((int32_t)r < 0) { q--; r += f; }
        x = (q << RSB) + r + st;
    }
    p -= 4;
    p[0] = (uint8_t)x; p[1] = (uint8_t)(x >> 8);
    p[2] = (uint8_t)(x >> 16); p[3] = (uint8_t)(x >> 24);
    uint32_t sz = (uint32_t)(base + cp - p);
    for (uint32_t j = 0; j < sz; j++) base[j] = p[j];
    olen[i] = sz;
}

/* ---------------------------------------------------------------- rANS dec */
__global__ void k_dec(const uint8_t * __restrict__ enc,
                      const uint32_t * __restrict__ eoff,
                      const uint32_t * __restrict__ elen,
                      const uint16_t * __restrict__ stab,
                      uint8_t * __restrict__ sym,
                      const uint32_t * __restrict__ soff,
                      const uint32_t * __restrict__ slen,
                      const dtab_t * __restrict__ tabs,
                      int * __restrict__ err,
                      int nstreams)
{
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= nstreams) return;
    uint32_t n = slen[i];
    if (n == 0) return;

    const dtab_t *t = &tabs[stab[i]];
    const uint8_t *in = enc + eoff[i];
    uint32_t len = elen[i];
    uint8_t *out = sym + soff[i];
    if (len < 4) { err[i] = 1; return; }

    size_t p = 4;
    uint32_t x = (uint32_t)in[0] | ((uint32_t)in[1] << 8) |
                 ((uint32_t)in[2] << 16) | ((uint32_t)in[3] << 24);
    for (uint32_t k = 0; k < n; k++) {
        uint32_t slot = x & (RSZ - 1);
        uint8_t s = t->slot[slot];
        out[k] = s;
        x = (uint32_t)t->freq[s] * (x >> RSB) + slot - t->start[s];
        while (x < RANS_L) {
            if (p >= len) { err[i] = 2; return; }
            x = (x << 8) | in[p++];
        }
    }
}

/* ------------------------------------------------------------- host helpers */
static double now_s()
{
    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec + 1e-9 * (double)ts.tv_nsec;
}

#define HIPCHECK(x) do { hipError_t e_ = (x); if (e_ != hipSuccess) { \
    fprintf(stderr, "%s:%d %s\n", __FILE__, __LINE__, hipGetErrorString(e_)); exit(1); } } while (0)

static std::vector<uint8_t> slurp(const char *path)
{
    FILE *f = fopen(path, "rb");
    if (!f) { fprintf(stderr, "cannot open %s\n", path); exit(1); }
    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
    std::vector<uint8_t> v((size_t)n);
    if (n && fread(v.data(), 1, (size_t)n, f) != (size_t)n) { fprintf(stderr, "short read %s\n", path); exit(1); }
    fclose(f);
    return v;
}

/* level sizes, identical to wavelet.c */
static int level_sizes(int w, int h, int levels, int *cw, int *ch)
{
    int nl = 0, a = w, b = h;
    for (int L = 0; L < levels; L++) {
        if (a < 2 || b < 2) break;
        cw[nl] = a; ch[nl] = b; nl++;
        a = (a + 1) / 2; b = (b + 1) / 2;
    }
    cw[nl] = a; ch[nl] = b;
    return nl;
}

/* build encoder tables from raw frequencies; shared by every harness so the
   reciprocal and start arrays can never drift between them */
static void build_gtabs(std::vector<gtab_t> &tabs, const std::vector<uint16_t> &freqs, uint32_t nsets)
{
    tabs.resize(nsets);
    for (uint32_t i = 0; i < nsets; i++) {
        uint32_t acc = 0;
        for (int k = 0; k < NSYM; k++) {
            uint16_t f = freqs[(size_t)i * NSYM + k];
            tabs[i].freq[k] = f;
            tabs[i].start[k] = acc;
            tabs[i].rcp[k] = f ? (uint32_t)(((1ULL << 31) / f) + 1) : 0;
            acc += f;
        }
        if (acc != RSZ) { fprintf(stderr, "table %u sums to %u\n", i, acc); exit(1); }
    }
}

/* ------------------------------------------------------- bitplane symbolise */
/* One stream = one code-block for one context. Stateless: a coefficient is significant at
   plane p iff |c| >= 2^p, and becomes significant iff |c| >> p == 1, so no per-coefficient
   state is carried. */
struct sdesc {
    int x0, y0, bw, bh;
    int mb;
    int ctx;        /* 0 siggrp, 1 sig, 2 sign, 3 refine */
    int tab;        /* subband*4 + ctx */
    int16_t *pl;    /* the plane this block lives in */
    int pw;         /* that plane's row stride */
    int bi;         /* block index, for the shared newly-significant flags */
};

__device__ __forceinline__ int blk_at(const int16_t *plane, int w, int y0, int x0, int cx, int cy)
{
    return plane[(y0 + cy) * w + x0 + cx];
}

__global__ void k_sym(const sdesc * __restrict__ d,
                      const uint32_t * __restrict__ nw,
                      uint8_t * __restrict__ out,
                      const uint32_t * __restrict__ boff,
                      uint32_t * __restrict__ nbits,
                      int nstreams, int emit)
{
    int s = blockIdx.x * blockDim.x + threadIdx.x;
    if (s >= nstreams) return;

    sdesc sd = d[s];
    int bw = sd.bw, bh = sd.bh, n = bw * bh, ctx = sd.ctx, pw = sd.pw;
    uint8_t *ob = emit ? out + boff[s] : nullptr;
    const int16_t *base = sd.pl + sd.y0 * pw + sd.x0;
    uint32_t nb = 0;
    int newly = 0;

    /* Raster walk with a row pointer: address arithmetic is one add per row, not a
       64-bit multiply per coefficient. Groups are 32 raster-ordered coefficients. */
    for (int p = sd.mb - 1; p >= 0; p--) {
        int i = 0;
        for (int y = 0; y < bh; y++) {
            const int16_t *row = base + y * pw;
            int x = 0;
            /* One iteration body. The packed path only changes how fast the row advances: it
               runs this twice per vector load, so the branch logic stays in one place. */
            auto step = [&](int xa, int v, int m) {
                if ((i & 31) == 0) {
                    newly = group_newly(row, xa, i, n, bw, pw, p, nw, sd.bi * 16 + p);
                    if (ctx == 0) {
                        if (emit && newly) ob[nb >> 3] |= (uint8_t)(1u << (nb & 7));
                        nb++;
                    }
                }
                i++;
                if (ctx != 0) sym_coef(v, m, p, ctx, newly, emit, ob, nb);
            };
            if (ctx != 0 && (bw & 1) == 0) {
                for (; x < bw; x += 2) {
                    v2s raw = *(const v2s *)&row[x];
                    int m0, m1;
                    v2abs(m0, m1, raw);
                    step(x, raw[0], m0);
                    step(x + 1, raw[1], m1);
                }
            } else {
                for (; x < bw; x++) {
                    int v = row[x];
                    step(x, v, v < 0 ? -v : v);
                }
            }
        }
    }
    nbits[s] = nb;
}

__global__ void k_offsets(const uint32_t * __restrict__ nbits, uint32_t * __restrict__ off, int n)
{
    if (blockIdx.x || threadIdx.x) return;
    uint32_t acc = 0;
    for (int i = 0; i < n; i++) { off[i] = acc; acc += (nbits[i] + 7) / 8; }
    off[n] = acc;
}

/* pack nbits LSB-first into SYMBITS-bit symbols, exactly as the reference does */
__global__ void k_pack(const uint8_t * __restrict__ bits,
                       const uint32_t * __restrict__ boff,
                       const uint32_t * __restrict__ nbits,
                       uint8_t * __restrict__ syms,
                       const uint32_t * __restrict__ soff,
                       uint32_t * __restrict__ nout,
                       int nstreams)
{
    int s = blockIdx.x * blockDim.x + threadIdx.x;
    if (s >= nstreams) return;
    const uint8_t *b = bits + boff[s];
    uint8_t *o = syms + soff[s];
    uint32_t ns = (nbits[s] + SYMBITS - 1) / SYMBITS;
    nout[s] = ns;
    for (uint32_t k = 0; k < ns; k++) {
        unsigned v = 0;
        for (int j = 0; j < SYMBITS; j++) {
            uint32_t bit = k * SYMBITS + (uint32_t)j;
            if (bit < nbits[s] && ((b[bit >> 3] >> (bit & 7)) & 1)) v |= 1u << j;
        }
        o[k] = (uint8_t)v;
    }
}

/* per-stream symbol histogram accumulated into its (subband, context) table */
__global__ void k_hist(const uint8_t * __restrict__ syms,
                       const uint32_t * __restrict__ soff,
                       const uint32_t * __restrict__ nsym,
                       const uint16_t * __restrict__ stab,
                       int * __restrict__ hist,
                       int nstreams)
{
    int s = blockIdx.x * blockDim.x + threadIdx.x;
    if (s >= nstreams) return;
    int local[NSYM];
    for (int k = 0; k < NSYM; k++) local[k] = 0;
    const uint8_t *p = syms + soff[s];
    uint32_t n = nsym[s];
    for (uint32_t i = 0; i < n; i++) local[p[i]]++;
    int *h = hist + (int)stab[s] * NSYM;
    for (int k = 0; k < NSYM; k++) if (local[k]) atomicAdd(h + k, local[k]);
}

/* pooled histogram per context, so cells too sparse to model can fall back */
__global__ void k_pool(const int * __restrict__ hist, int * __restrict__ pooled,
                       int nsets, int nctx)
{
    int c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c >= nctx) return;
    int *po = pooled + (size_t)c * NSYM;
    for (int k = 0; k < NSYM; k++) po[k] = 0;
    for (int t = c; t < nsets; t += nctx) {
        const int *h = hist + (size_t)t * NSYM;
        for (int k = 0; k < NSYM; k++) po[k] += h[k];
    }
}

/* normalise each table exactly as rtab_build does, then emit freq[]. Cells below the
   symbol threshold use the pooled table for their context, matching the reference. */
__global__ void k_norm(const int * __restrict__ hist, const int * __restrict__ pooled,
                       uint16_t * __restrict__ freq, int nsets, int nctx, int min_syms)
{
    int t = blockIdx.x * blockDim.x + threadIdx.x;
    if (t >= nsets) return;
    const int *h = hist + (size_t)t * NSYM;
    uint64_t celltot = 0;
    for (int k = 0; k < NSYM; k++) celltot += (uint64_t)h[k];
    if (celltot < (uint64_t)min_syms) h = pooled + (size_t)(t % nctx) * NSYM;
    uint16_t *out = freq + (size_t)t * NSYM;

    uint64_t tot = 0;
    int present = 0;
    for (int i = 0; i < NSYM; i++) { tot += (uint64_t)h[i]; if (h[i]) present++; }
    uint32_t f[NSYM];
    for (int i = 0; i < NSYM; i++) f[i] = 0;
    if (tot == 0) {
        for (int i = 0; i < NSYM; i++) out[i] = 0;
        out[0] = RSZ;
        return;
    }
    uint64_t room = (uint64_t)RSZ - (uint64_t)present;
    for (int i = 0; i < NSYM; i++)
        if (h[i]) f[i] = (uint32_t)(((uint64_t)h[i] * room) / tot) + 1;

    uint64_t sum = 0;
    for (int i = 0; i < NSYM; i++) sum += f[i];
    int i = 0;
    while (sum > RSZ) { if (f[i] > 1) { f[i]--; sum--; } i = (i + 1) % NSYM; }
    while (sum < RSZ) { if (f[i])    { f[i]++; sum++; } i = (i + 1) % NSYM; }
    for (int k = 0; k < NSYM; k++) out[k] = (uint16_t)f[k];
}

/* ----------------------------------------------------- bitplane desymbolise */
/* symbols -> packed bits, per stream */
__global__ void k_unpack(const uint8_t * __restrict__ syms,
                         const uint32_t * __restrict__ soff,
                         const uint32_t * __restrict__ nsym,
                         uint8_t * __restrict__ bits,
                         const uint32_t * __restrict__ boff,
                         int nstreams)
{
    int s = blockIdx.x * blockDim.x + threadIdx.x;
    if (s >= nstreams) return;
    const uint8_t *in = syms + soff[s];
    uint32_t ns = nsym[s];
    uint8_t *o = bits + boff[s];
    size_t nbytes = ((size_t)ns * SYMBITS + 7) / 8;
    for (size_t i = 0; i < nbytes; i++) o[i] = 0;
    for (uint32_t k = 0; k < ns; k++)
        for (int j = 0; j < SYMBITS; j++)
            if ((in[k] >> j) & 1) {
                size_t b = (size_t)k * SYMBITS + j;
                o[b >> 3] |= (uint8_t)(1u << (b & 7));
            }
}

struct bdesc { int x0, y0, bw, bh, mb; int16_t *pl; int pw; };

/* block bitplane count, so the host never has to download the whole plane to learn it */
__global__ void k_block_mb(bdesc * __restrict__ bd, int nblocks)
{
    int b = blockIdx.x * blockDim.x + threadIdx.x;
    if (b >= nblocks) return;
    bdesc d = bd[b];
    int mx = 0;
    for (int y = 0; y < d.bh; y++) {
        const int16_t *row = d.pl + (d.y0 + y) * d.pw + d.x0;
        for (int x = 0; x < d.bw; x++) {
            int v = row[x]; v = v < 0 ? -v : v;
            if (v > mx) mx = v;
        }
    }
    int mb = 0;
    while (mx) { mb++; mx >>= 1; }
    bd[b].mb = mb;
}

/* One thread per (block, plane): the same scan the four context streams would each do for
   themselves, done once and shared. Bit g of the mask says group g becomes significant here. */
__global__ void k_newly(const bdesc * __restrict__ bd, int nblocks, uint32_t * __restrict__ nw)
{
    int t = blockIdx.x * blockDim.x + threadIdx.x;
    int b = t >> 4, p = t & 15;
    if (b >= nblocks) return;
    bdesc d = bd[b];
    if (p >= d.mb) { nw[b * 16 + p] = 0; return; }

    int bw = d.bw, bh = d.bh, pw = d.pw;
    int16_t *base = d.pl + d.y0 * pw + d.x0;
    uint32_t mask = 0;
    int i = 0;
    for (int y = 0; y < bh; y++) {
        const int16_t *row = base + (size_t)y * pw;
        for (int x = 0; x < bw; x++, i++) {
            int m = row[x]; if (m < 0) m = -m;
            if (!(m >> (p + 1)) && ((m >> p) & 1)) mask |= 1u << (i >> 5);
        }
    }
    nw[b * 16 + p] = mask;
}

/* Warp scan over 32 lanes (exclusive result, total returned through *total). */
__device__ __forceinline__ int warp_scan(int v, int lane, int *total)
{
    int incl = v;
    for (int off = 1; off < 32; off <<= 1) {
        int t = __shfl_up(incl, off, 32);
        if (lane >= off) incl += t;
    }
    *total = __shfl(incl, 31, 32);
    return incl - v;
}

/* One warp per code-block, one lane per 32-coefficient group.
   Every bit position here is derived from a mask rather than a serial scan: the siggrp stream
   takes exactly one bit per group per plane, so its position is analytic, and the sig, refine
   and sign bases are warp prefix sums of per-group counts. Same bitstream as k_desym, decoded
   32 lanes wide, so the serial length per block drops from coefficients x planes to
   coefficients-per-group x planes. Blocks with more than 32 groups use k_desym. */
__global__ void k_desym_w(const uint8_t * __restrict__ bits,
                          const uint32_t * __restrict__ boff,
                          const bdesc * __restrict__ bd, int nblocks)
{
    int tid  = blockIdx.x * blockDim.x + threadIdx.x;
    int w    = tid >> 5;
    int lane = tid & 31;
    if (w >= nblocks) return;

    bdesc d = bd[w];
    int bw = d.bw, bh = d.bh, n = bw * bh, pw = d.pw;
    int ng = (n + 31) / 32;
    int16_t *base = d.pl + d.y0 * pw + d.x0;

    const uint8_t *stg = bits + boff[w * 4 + 0];
    const uint8_t *sts = bits + boff[w * 4 + 1];
    const uint8_t *stn = bits + boff[w * 4 + 2];
    const uint8_t *str = bits + boff[w * 4 + 3];

    int g = lane;
    int have = (g < ng);
    int start = g * 32;
    int cnt = have ? (n - start < 32 ? n - start : 32) : 0;
    int cy = have ? start / bw : 0;
    int cx = have ? start - cy * bw : 0;

    uint32_t sgnmask = 0;
    size_t sig_head = 0, ref_head = 0, sgn_head = 0;

    for (int p = d.mb - 1; p >= 0; p--) {
        size_t gpos = (size_t)ng * (size_t)(d.mb - 1 - p) + (size_t)g;
        int newly = have ? (int)((stg[gpos >> 3] >> (gpos & 7)) & 1) : 0;

        /* classify my group: already significant, or newly significant at this plane */
        uint32_t amask = 0, qmask = 0;
        int csig = 0, cref = 0;
        if (cx == 0 && cnt == bw && (bw & 1) == 0) {
            /* whole rows, contiguous: two coefficients per load, arithmetic packed */
            int16_t *rp = base + (size_t)cy * pw;
            for (int k = 0; k < cnt; k += 2) {
                int m0, m1;
                v2abs(m0, m1, *(const v2s *)&rp[k]);
                classify(m0, p, newly, k, amask, qmask, csig, cref);
                classify(m1, p, newly, k + 1, amask, qmask, csig, cref);
            }
        } else {
            int16_t *rp = base + (size_t)cy * pw;
            int tx = cx;
            for (int k = 0; k < cnt; k++) {
                int m = rp[tx]; if (m < 0) m = -m;
                classify(m, p, newly, k, amask, qmask, csig, cref);
                if (++tx == bw) { tx = 0; rp += pw; }
            }
        }

        int tsig, tref, tsgn;
        int my_sig = warp_scan(csig, lane, &tsig);
        int my_ref = warp_scan(cref, lane, &tref);
        size_t pos_sig = sig_head + my_sig;
        size_t pos_ref = ref_head + my_ref;

        /* read refine and sig bits, write magnitudes, note which need a sign bit */
        uint32_t smask = 0;
        {
            int16_t *rp = base + (size_t)cy * pw;
            int tx = cx;
            for (int k = 0; k < cnt; k++) {
                int16_t *q = &rp[tx];
                int m = *q; if (m < 0) m = -m;
                if ((amask >> k) & 1u) {
                    if ((str[pos_ref >> 3] >> (pos_ref & 7)) & 1) m |= (1 << p);
                    pos_ref++;
                    *q = (int16_t)m;
                } else if ((qmask >> k) & 1u) {
                    int sbit = (sts[pos_sig >> 3] >> (pos_sig & 7)) & 1;
                    pos_sig++;
                    if (sbit) { *q = (int16_t)(1 << p); smask |= 1u << k; }
                }
                if (++tx == bw) { tx = 0; rp += pw; }
            }
        }

        int csgn = __popc(smask);
        int my_sign = warp_scan(csgn, lane, &tsgn);
        size_t pos_sign = sgn_head + my_sign;
        if (csgn) {
            for (int k = 0; k < cnt; k++)
                if ((smask >> k) & 1u) {
                    if ((stn[pos_sign >> 3] >> (pos_sign & 7)) & 1) sgnmask |= 1u << k;
                    pos_sign++;
                }
        }

        sig_head += (size_t)tsig;
        ref_head += (size_t)tref;
        sgn_head += (size_t)tsgn;
    }

    if (sgnmask) {
        int16_t *rp = base + (size_t)cy * pw;
        int tx = cx;
        for (int k = 0; k < cnt; k++) {
            if ((sgnmask >> k) & 1u) rp[tx] = (int16_t)(-rp[tx]);
            if (++tx == bw) { tx = 0; rp += pw; }
        }
    }
}

/* One thread per code-block: the walk interleaves the four contexts, so it cannot be split
   per context. Magnitude is accumulated straight into the destination plane and the sign is
   held in a small bitmap, which avoids a per-coefficient state array. */
template <int MAXN>
__global__ void k_desym(const uint8_t * __restrict__ bits,
                        const uint32_t * __restrict__ boff,
                        const bdesc * __restrict__ bd, int nblocks)
{
    int b = blockIdx.x * blockDim.x + threadIdx.x;
    if (b >= nblocks) return;

    bdesc d = bd[b];
    int bw = d.bw, bh = d.bh, n = bw * bh, pw = d.pw;
    int16_t *base = d.pl + d.y0 * pw + d.x0;
    const uint8_t *st[4];
    size_t pos[4] = {0, 0, 0, 0};
    for (int c = 0; c < 4; c++) st[c] = bits + boff[b * 4 + c];

    /* the plane is zeroed by the caller, so a non-significant coefficient is already 0 */
    uint32_t sgn[MAXN / 32];
    for (int i = 0; i < (n + 31) / 32; i++) sgn[i] = 0;

    for (int p = d.mb - 1; p >= 0; p--) {
        int i = 0, newly = 0;
        for (int y = 0; y < bh; y++) {
            int16_t *row = base + y * pw;
            for (int x = 0; x < bw; x++, i++) {
                if ((i & 31) == 0) {
                    newly = (st[0][pos[0] >> 3] >> (pos[0] & 7)) & 1;
                    pos[0]++;
                }
                int16_t *q = &row[x];
                int m = *q;
                if (m >> (p + 1)) {
                    int bit = (st[3][pos[3] >> 3] >> (pos[3] & 7)) & 1;
                    pos[3]++;
                    if (bit) *q = (int16_t)(m | (1 << p));
                } else if (newly) {
                    int sbit = (st[1][pos[1] >> 3] >> (pos[1] & 7)) & 1;
                    pos[1]++;
                    if (sbit) {
                        int sg = (st[2][pos[2] >> 3] >> (pos[2] & 7)) & 1;
                        pos[2]++;
                        *q = (int16_t)(1 << p);
                        if (sg) sgn[i >> 5] |= 1u << (i & 31);
                    }
                }
            }
        }
    }
    for (int y = 0, k = 0; y < bh; y++) {
        int16_t *row = base + (size_t)y * pw;
        for (int x = 0; x < bw; x++, k++)
            if ((sgn[k >> 5] >> (k & 31)) & 1) row[x] = (int16_t)(-row[x]);
    }
}

#endif
